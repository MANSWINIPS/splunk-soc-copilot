# --- Splunk connection (REST API for fallback queries) ---
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_SCHEME=https
SPLUNK_VERIFY_SSL=false

# --- Splunk MCP Server (token auth; OAuth is CA/not GA yet) ---
SPLUNK_MCP_URL=http://localhost:8001/mcp
SPLUNK_MCP_TOKEN=replace-with-mcp-bearer-token

# --- Splunk Hosted Models ---
# Pick one model per role; Foundation-Sec is the security-tuned model.
SPLUNK_HOSTED_MODEL_URL=https://localhost:8089/services/ml/v1/models
SPLUNK_HOSTED_MODEL_TOKEN=replace-with-splunk-auth-token
SPLUNK_REASONING_MODEL=Foundation-Sec-1.1-8B-Instruct
SPLUNK_GENERATION_MODEL=gpt-oss-20b

# --- Agent behavior ---
SOC_COPILOT_MAX_ITERATIONS=6
SOC_COPILOT_FEEDBACK_INDEX=soc_copilot_feedback
SOC_COPILOT_FINDINGS_INDEX=soc_copilot_findings
SOC_COPILOT_LOG_LEVEL=INFO

# --- HTTP Event Collector (primary write/ingest path; port 8088) ---
# HEC traverses corporate firewalls without an 8089 IP allowlist. On Splunk Cloud,
# enable HEC under Settings > Data inputs > HTTP Event Collector and create a token.
SPLUNK_HEC_URL=https://your-stack.splunkcloud.com:8088/services/collector
SPLUNK_HEC_TOKEN=replace-with-hec-token
